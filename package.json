{
  "name": "bizpilot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "mobile:build": "CAPACITOR_BUILD=1 VITE_API_URL=${BIZPILOT_API_URL:-https://bizpilot-api-t8bl.onrender.com} npm run build -w frontend",
    "mobile:sync": "npm run mobile:build && cap sync",
    "mobile:add:ios": "cap add ios",
    "mobile:add:android": "cap add android",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android",
    "start": "npm run start -w backend",
    "typecheck": "npm run typecheck -w backend && npm run typecheck -w frontend"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "concurrently": "^9.2.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3"
  }
}
